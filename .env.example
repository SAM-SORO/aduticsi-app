# =============================================================================
#  Base de données (Prisma 7 + adapter pg)
# =============================================================================
# Instance Supabase self-hosted. Si aucun pooler (Supavisor/PgBouncer) n'est
# placé devant Postgres, DATABASE_URL et DIRECT_URL sont identiques.
DATABASE_URL=postgresql://user:password@host:5432/postgres
DIRECT_URL=postgresql://user:password@host:5432/postgres

# Optionnel — utilisé uniquement par scripts/test-db.ts
POOLED_DATABASE_URL=

# =============================================================================
#  Supabase (API / Auth / Storage)
# =============================================================================
# ⚠️ NEXT_PUBLIC_SUPABASE_URL est lu au BUILD par next.config.ts pour
#    whitelister le hostname des images (next/image). Il doit donc être présent
#    aussi bien au build qu'au runtime.
NEXT_PUBLIC_SUPABASE_URL=https://supabase.aduticsi.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# =============================================================================
#  URLs publiques de l'application
# =============================================================================
# Utilisée par metadataBase (app/layout.tsx)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# Utilisée pour générer les liens d'invitation (dashboard super-admin).
# Si vide, l'URL est déduite dynamiquement des en-têtes de la requête.
NEXT_PUBLIC_APP_URL=

# =============================================================================
#  SMTP applicatif (contact / réponses) — indépendant du SMTP Supabase Auth
# =============================================================================
SMTP_HOST=your_smtp_host_here
SMTP_PORT=465
SMTP_USER=your_smtp_user_here
SMTP_PASS=your_smtp_password_here
SMTP_FROM=your_smtp_from_address_here
SMTP_FROM_NAME=ADUTI Support

# =============================================================================
#  Cloudflare Turnstile (anti-bot)
# =============================================================================
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_turnstile_secret_key_here

# =============================================================================
#  Divers
# =============================================================================
# trace | debug | info | warn | error  (défaut : info)
LOG_LEVEL=
